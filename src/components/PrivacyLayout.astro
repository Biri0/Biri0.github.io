---
import "../styles/global.css";

export interface Props {
  title: string;
  appName: string;
  lastUpdated: string;
  accentColor?: string;
}

const { title, appName, lastUpdated, accentColor = "#3498db" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  </head>
  <body class="min-h-dvh bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <div class="max-w-[800px] mx-auto my-8 md:my-10 px-4">
      <div class="rounded-xl border border-zinc-950/10 dark:border-white/10 bg-white/60 dark:bg-white/[0.03] backdrop-blur p-5 md:p-6 shadow-sm" style={`--accent-color: ${accentColor}`}>
        <h1
          class="text-2xl md:text-3xl font-bold text-zinc-900 dark:text-zinc-100 border-b-4 pb-2"
          style={`border-color: ${accentColor}`}
        >
          {title}
        </h1>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 italic">Last updated: {lastUpdated}</p>

        <div class="mt-6 space-y-4">
          <slot />
        </div>

        <div class="mt-8 rounded-lg border border-zinc-950/10 dark:border-white/10 bg-white/60 dark:bg-white/[0.03] p-4 md:p-5">
          <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Contact</h2>
          <p class="mt-2 text-zinc-700 dark:text-zinc-300">For questions regarding this privacy policy or the {appName} app, you can contact us through:</p>
          <ul class="mt-2 list-disc pl-6 text-zinc-700 dark:text-zinc-300">
            <li>
              Email:
              <a
                href="mailto:privacy@rfmariano.it"
                class="text-[var(--accent-color)] underline underline-offset-2 decoration-2 hover:opacity-80"
              >
                privacy@rfmariano.it
              </a>
            </li>
          </ul>
          <slot name="additional-contact" />
        </div>
      </div>
    </div>
  </body>
</html>
