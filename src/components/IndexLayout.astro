---
import { Image } from "astro:assets";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import "../styles/global.css";
import "../styles/portfolio.css";
import type { Locale, SiteData, Labels, AlternateUrl } from "../types/index.ts";

export interface Props {
  currentLocale: Locale;
  title: string;
  description: string;
  canonicalUrl: string;
  ogLocale: string;
  ogUrl: string;
  alternateUrls: AlternateUrl[];
  site: SiteData;
  labels: Labels;
}

const { currentLocale, title, description, canonicalUrl, ogLocale, ogUrl, alternateUrls, site, labels } = Astro.props;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f9fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17191d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={site.seo.image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.seo.image} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrls.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="icon" href={site.favicon} />
  </head>
  <body id="top" class="portfolio-body">
    <a class="skip-link" href="#main">{labels.accessibility.skip_content}</a>

    <header class="site-header">
      <nav class="nav wrap" aria-label={labels.accessibility.primary_navigation}>
        <a class="wordmark" href="#top" aria-label={labels.nav.home_label}>
          <Image class="wordmark-portrait" src="/me.jpeg" alt="" width={44} height={44} format="webp" quality={90} loading="eager" />
          <span class="wordmark-name">{site.title}</span>
        </a>
        <div class="nav-links">
          <a href="#projects">{labels.nav.projects}</a>
          <a href="#record">{labels.nav.record}</a>
          <a href="#contact">{labels.nav.contact}</a>
          <LanguageSwitcher currentLocale={currentLocale} label={labels.accessibility.choose_language} />
        </div>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner wrap">
        <span>© <span id="year"></span> {site.title} · {labels.footer.built_with}</span>
        <a class="back-top" href="#top">{labels.footer.back_to_top} <span aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <script>
      const year = document.getElementById("year");
      if (year) year.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
