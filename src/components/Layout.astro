---
import site from "../data/site.json";
import "../styles/global.css";

export interface Props {
    title?: string;
}

const { title = site.title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/jpeg" href="/me.jpeg" />
  </head>
  <body class="min-h-dvh bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <div>
      <header class="border-b border-black/5 dark:border-white/10" role="banner" aria-label="Site header">
        <div class="max-w-[1100px] mx-auto my-14 px-5 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <img src="/me.jpeg" alt={site.title} class="w-12 h-12 rounded-lg object-cover inline-block" width="48" height="48" />
            <div class="leading-tight">
              <div class="font-semibold text-base">{site.title}</div>
              <div class="text-sm text-zinc-600 dark:text-zinc-400">{site.description.en}</div>
            </div>
          </div>
          <nav class="flex items-center gap-2" role="navigation" aria-label="Primary">
            <slot name="nav" />
          </nav>
        </div>
      </header>

      <main id="content" role="main" class="max-w-[1100px] mx-auto px-5">
        <slot />
      </main>

      <footer class="mt-12 border-t border-black/5 dark:border-white/10" role="contentinfo">
        <div class="max-w-[1100px] mx-auto px-5 py-6 flex items-center justify-between gap-4 text-sm text-zinc-600 dark:text-zinc-400">
          <div>© <span id="year"></span> {site.title}</div>
          <div>
            <slot name="footer" />
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<script>
  (function () {
    try {
      const y = document.getElementById("year");
      if (y) y.textContent = String(new Date().getFullYear());
    } catch (e) {}
  })();
</script>
