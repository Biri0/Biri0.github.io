---
import site from "../data/site.json";
// Import global stylesheet (create `src/styles.css` if not present)
import "../styles.css";

export interface Props {
    title?: string;
}

const { title = site.title } = Astro.props;
---

<!--
  Layout.astro
  - Imports global CSS
  - Provides a simple page wrapper with header/footer and main slot
  - Usage:
      ---
      import Layout from '../components/Layout.astro';
      ---
      <Layout title="Home">
        <h1>Content</h1>
      </Layout>
--><!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="icon" type="image/jpeg" href="/me.jpeg" />
    </head>
    <body>
        <div class="site">
            <header class="site-header" role="banner" aria-label="Site header">
                <div class="wrap">
                    <div class="brand">
                        <img
                            src="/me.jpeg"
                            alt={site.title}
                            class="brand-img"
                            width="48"
                            height="48"
                        />
                        <div class="brand-meta">
                            <div class="brand-title">{site.title}</div>
                            <div class="brand-desc">{site.description.en}</div>
                        </div>
                    </div>

                    <nav
                        class="site-nav"
                        role="navigation"
                        aria-label="Primary"
                    >
                        <slot name="nav" />
                    </nav>
                </div>
            </header>

            <main class="site-main" id="content" role="main">
                <div class="wrap">
                    <slot />
                </div>
            </main>

            <footer class="site-footer" role="contentinfo">
                <div class="wrap footer-inner">
                    <div class="footer-left">
                        <small>© <span id="year"></span> {site.title}</small>
                    </div>
                    <div class="footer-right">
                        <slot name="footer" />
                    </div>
                </div>
            </footer>
        </div>
    </body>
</html>

<script>
    // Small runtime helpers kept inline for simplicity:
    // - Sets copyright year
    (function () {
        try {
            const y = document.getElementById("year");
            if (y) y.textContent = String(new Date().getFullYear());
        } catch (e) {
            // silent
        }
    })();
</script>

<style>
    /* Logo image used in the header */
    .brand-img {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        object-fit: cover;
        display: inline-block;
    }

    /* Hide textual brand fallback so there's no duplicate */
    .brand-logo {
        display: none;
    }
</style>
