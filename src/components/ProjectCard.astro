---
/**
 * ProjectCard.astro
 *
 * Reusable project card component for the developer-focused site.
 * TailwindCSS utilities replace previous scoped styles.
 */
import type { Labels } from "../types/index.ts";

export interface Props {
  id?: string;
  title: string;
  description?: string;
  tech?: string[];
  repo?: string;
  live?: string;
  play?: string;
  pkg?: string;
  labels?: Labels;
  target?: string;
  rel?: string;
}

const {
  id = "",
  title = "Untitled Project",
  description = "",
  tech = [],
  repo = "",
  live = "",
  play = "",
  labels = null,
  target = "_blank",
  rel = "noopener noreferrer",
} = Astro.props;

const hasActions = Boolean((live && live.trim()) || (play && play.trim()) || (repo && repo.trim()));
---

<article
  class="h-full rounded-xl border border-zinc-950/10 dark:border-white/10 bg-white/40 dark:bg-white/[0.03] p-4 md:p-5 shadow-sm backdrop-blur transition will-change-transform hover:-translate-y-1 hover:shadow-lg hover:border-teal-300/30"
  role="article"
  aria-labelledby={id ? `${id}-title` : undefined}
>
  <div class="flex-1 flex flex-col gap-3">
    <h3 id={id ? `${id}-title` : undefined} class="m-0 text-base font-semibold text-zinc-900 dark:text-zinc-100">
      {title}
    </h3>
    {description ? (
      <p class="m-0 text-sm text-zinc-600 dark:text-zinc-400 leading-6">{description}</p>
    ) : null}

    {tech && tech.length > 0 ? (
      <ul
        class="m-0 mt-2 list-none p-0 flex flex-wrap gap-2"
        role="list"
        aria-label={
          labels &&
          labels.project_card &&
          labels.project_card.techs_label
            ? labels.project_card.techs_label
            : "Technologies"
        }
      >
        {tech.map((t) => (
          <li class="text-[0.8rem] font-medium rounded-md border border-teal-300/20 bg-teal-300/10 px-2.5 py-1 text-zinc-500 dark:text-zinc-300">
            {t}
          </li>
        ))}
      </ul>
    ) : null}
  </div>

  {hasActions ? (
    <div class="mt-4 pt-3 flex flex-col sm:flex-row gap-2">
      {(() => {
        const safeLive = typeof live === "string" && live.trim() ? live : null;
        const safePlay = typeof play === "string" && play.trim() ? play : null;
        const safeRepo = typeof repo === "string" && repo.trim() ? repo : null;

        return (
          <>
            {safeLive ? (
              <a
                class="inline-flex items-center justify-center rounded-md bg-gradient-to-tr from-teal-300 to-sky-400 px-4 py-2 text-sm font-semibold text-white no-underline shadow-md transition hover:shadow-lg hover:scale-[1.02]"
                href={safeLive}
                target={target}
                rel={rel}
                title={
                  labels &&
                  labels.project_card &&
                  labels.project_card.live_title
                    ? `${labels.project_card.live_title}: ${title}`
                    : `Open site: ${title}`
                }
              >
                {labels && labels.buttons && labels.buttons.site ? labels.buttons.site : "Site"}
              </a>
            ) : null}

            {safePlay ? (
              <a
                class="inline-flex items-center justify-center rounded-md bg-gradient-to-tr from-teal-300 to-sky-400 px-4 py-2 text-sm font-semibold text-white no-underline shadow-md transition hover:shadow-lg hover:scale-[1.02]"
                href={safePlay}
                target={target}
                rel={rel}
                title={
                  labels &&
                  labels.project_card &&
                  labels.project_card.play_title
                    ? `${labels.project_card.play_title}: ${title}`
                    : `Open on Play Store: ${title}`
                }
              >
                {labels && labels.buttons && labels.buttons.play ? labels.buttons.play : "Play Store"}
              </a>
            ) : null}

            {safeRepo ? (
              <a
                class="inline-flex items-center justify-center rounded-md bg-gradient-to-tr from-teal-300 to-sky-400 px-4 py-2 text-sm font-semibold text-white no-underline shadow-md transition hover:shadow-lg hover:scale-[1.02]"
                href={safeRepo}
                target={target}
                rel={rel}
                title={
                  labels &&
                  labels.project_card &&
                  labels.project_card.repo_title
                    ? `${labels.project_card.repo_title}: ${title}`
                    : `View repository: ${title}`
                }
              >
                {labels && labels.buttons && labels.buttons.repo ? labels.buttons.repo : "Repo"}
              </a>
            ) : null}
          </>
        );
      })()}
    </div>
  ) : null}
</article>
