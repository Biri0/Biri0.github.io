---
import type { Labels, ProcessedProject } from "../types/index.ts";

export interface Props {
  project: ProcessedProject;
  number: number;
  labels: Labels["projects"];
}

const { project, number, labels } = Astro.props;
const displayNumber = String(number).padStart(2, "0");
---

<article class="project" data-category={project.category}>
  <span class="project-no">{displayNumber}</span>
  <div>
    <h3>{project.title}</h3>
    <span class="project-type">{project.type}</span>
  </div>
  <p class="project-description">{project.desc}</p>
  <div class="project-meta">
    <p class="tech">{project.tech.join(" · ")}</p>
    <div class="project-links">
      {project.play && <a href={project.play} target="_blank" rel="noopener noreferrer">{labels.play_store} <span aria-hidden="true">↗</span></a>}
      {project.live && <a href={project.live} target="_blank" rel="noopener noreferrer">{labels.visit_website} <span aria-hidden="true">↗</span></a>}
      {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer">{labels.source} <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>
