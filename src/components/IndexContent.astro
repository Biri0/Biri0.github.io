---
import ProjectCard from "./ProjectCard.astro";
import type { SiteData, Labels, ProcessedProject, ProcessedParticipation } from "../types/index.ts";

export interface Props {
  site: SiteData;
  labels: Labels;
  projects: ProcessedProject[];
  participations: Record<string, ProcessedParticipation>;
  ordinalFunc: (n: number | string) => string;
}

const { site, labels, projects, participations, ordinalFunc } = Astro.props;
const results = Object.values(participations)
  .flatMap((participation) => participation.entries.map((entry) => ({
    ...entry,
    name: participation.name,
    discipline: participation.discipline,
    url: entry.url || participation.url,
  })))
  .sort((a, b) => b.year - a.year || a.name.localeCompare(b.name));
---

<main id="main">
  <section class="hero" aria-label={labels.accessibility.introduction}>
    <div class="hero-grid wrap">
      <div class="hero-copy">
        <p class="eyebrow">{labels.hero.eyebrow}</p>
        <h1 class="hero-lead">{labels.hero.introduction}</h1>
        <div class="hero-actions">
          <a class="primary" href="#projects">{labels.hero.projects_cta} <span aria-hidden="true">↓</span></a>
          <a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">{labels.hero.github_cta} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <div class="section-grid wrap">
      <header class="section-index">
        <div>
          <p class="eyebrow">{labels.projects.eyebrow}</p>
          <h2 id="projects-title">{labels.projects.title}</h2>
        </div>
        <p>{labels.projects.introduction}</p>
      </header>
      <div class="section-content">
        <div class="project-toolbar">
          <div class="filters" role="group" aria-label={labels.accessibility.filter_projects}>
            <button class="filter" type="button" data-filter="all" aria-pressed="true">{labels.projects.all}</button>
            <button class="filter" type="button" data-filter="android" aria-pressed="false">{labels.projects.android}</button>
            <button class="filter" type="button" data-filter="web" aria-pressed="false">{labels.projects.web}</button>
          </div>
          <span class="project-count" aria-live="polite" data-shown-label={labels.projects.shown}>{String(projects.length).padStart(2, "0")} {labels.projects.shown}</span>
        </div>
        <div class="projects">
          {projects.map((project, index) => <ProjectCard project={project} number={index + 1} labels={labels.projects} />)}
        </div>
      </div>
    </div>
  </section>

  <section id="record" aria-labelledby="record-title">
    <div class="section-grid wrap">
      <header class="section-index">
        <div>
          <p class="eyebrow">{labels.record.eyebrow}</p>
          <h2 id="record-title">{labels.record.title}</h2>
        </div>
        <p>{labels.record.summary}</p>
      </header>
      <div class="section-content">
        <p class="competition-intro">{labels.record.introduction}</p>
        <div class="table-scroll" tabindex="0">
          <table class="results">
            <thead>
              <tr><th>{labels.record.year}</th><th>{labels.record.competition}</th><th>{labels.record.discipline}</th><th>{labels.record.result}</th></tr>
            </thead>
            <tbody>
              {results.map((entry) => (
                <tr>
                  <td>{entry.year}</td>
                  <td><a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.name} <span aria-hidden="true">↗</span></a></td>
                  <td>{entry.discipline}</td>
                  <td>{ordinalFunc(entry.rank)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="contact" id="contact" aria-label={labels.nav.contact}>
    <div class="contact-grid wrap">
      <div class="contact-side">
        <p>{labels.contact.message}</p>
        <div class="contact-links">
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail} <span aria-hidden="true">↗</span></a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const projectRows = Array.from(document.querySelectorAll<HTMLElement>(".project"));
  const count = document.querySelector<HTMLElement>(".project-count");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      let visible = 0;

      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      projectRows.forEach((project) => {
        const show = filter === "all" || project.dataset.category === filter;
        project.hidden = !show;
        if (show) visible += 1;
      });

      if (count) count.textContent = `${String(visible).padStart(2, "0")} ${count.dataset.shownLabel ?? ""}`.trim();
    });
  });
</script>
