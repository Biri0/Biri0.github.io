---
/*
  IndexContent component - Shared main content for both EN/IT index pages
  - Renders hero section, bio, location, and projects
  - Accepts locale-specific data as props
*/

import ProjectCard from "./ProjectCard.astro";
import { t, type Locale } from "../utils/i18n.ts";
import type {
    SiteData,
    Labels,
    ProcessedProject,
    ProcessedParticipation,
    ParticipationEntry,
} from "../types/index.ts";

export interface Props {
    site: SiteData;
    currentLocale: Locale;
    labels: Labels;
    projects: ProcessedProject[];
    participations: Record<string, ProcessedParticipation>;
    ordinalFunc: (n: number | string) => string;
}

const { site, currentLocale, labels, projects, participations, ordinalFunc } =
    Astro.props;
---

<main class="mt-5 grid gap-5 items-start md:grid-cols-[minmax(0,1fr)_360px]">
  <section class="rounded-xl border border-zinc-950/10 dark:border-white/10 bg-white/40 dark:bg-white/[0.03] backdrop-blur p-4 md:p-5 shadow-sm" aria-labelledby="hero-title">
    <div>
      <h1 id="hero-title" class="text-3xl md:text-4xl font-extrabold leading-tight text-zinc-950 dark:bg-gradient-to-tr dark:from-teal-300 dark:via-sky-400 dark:to-purple-500 dark:bg-clip-text dark:text-transparent">
        {labels.headings.hero_title}
      </h1>
      <p class="mt-3 text-base md:text-lg leading-7 text-zinc-600 dark:text-zinc-300 max-w-[90%]">
        {site.bio[currentLocale] || site.bio.en}
      </p>

      <div class="flex justify-end mt-4 md:mt-6">
        <div class="rounded-xl border border-teal-600/25 dark:border-teal-300/30 bg-teal-600/10 dark:bg-teal-300/10 px-4 py-3 text-center shadow-md backdrop-blur">
          <div class="text-xs font-semibold uppercase tracking-wide text-teal-700 dark:text-teal-300">
            {labels.headings.location}
          </div>
          <div class="mt-1 font-bold text-zinc-900 dark:text-zinc-100">
            {labels.headings.location_value}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <h2 id="projects" class="text-xl md:text-2xl font-bold text-zinc-900 dark:text-white">
        {labels.headings.selected_projects}
      </h2>
      <div class="mt-2 h-0.5 w-16 rounded bg-gradient-to-r from-teal-300 to-sky-400"></div>
      <ul
        class="mt-5 grid gap-4 sm:grid-cols-2 list-none m-0 p-0"
        aria-label={t("misc.projects_list_aria", currentLocale)}
      >
        {
          projects.map((p) => (
            <li role="listitem">
              <ProjectCard
                id={p.id}
                title={p.title}
                description={p.desc}
                tech={p.tech}
                repo={p.repo}
                live={p.live}
                play={p.play}
                labels={labels}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <aside class="md:sticky md:top-8 md:h-fit rounded-xl border border-zinc-950/10 dark:border-white/10 bg-white/40 dark:bg-white/[0.03] backdrop-blur p-4 md:p-5 shadow-sm" aria-labelledby="aside-title">
    <div class="mb-8">
      <div class="mb-4">
        <h3 id="aside-title" class="text-lg font-bold text-zinc-900 dark:text-white">
          {labels.headings.olympiad_participations}
        </h3>
        <p class="m-0 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
          {labels.headings.olympiad_description}
        </p>
      </div>

      <div role="region" aria-label="Olympiad participations">
        <div class="mt-4 overflow-hidden rounded-lg ring-1 ring-zinc-900/10 dark:ring-white/10 bg-white/40 dark:bg-white/[0.03]">
          <table class="w-full border-collapse">
            <thead>
              <tr class="bg-teal-600/5 dark:bg-teal-300/10 border-b border-teal-600/20 dark:border-teal-300/20">
                <th class="text-left px-3 py-2 text-sm font-semibold text-sky-700 dark:text-sky-300">
                  {t("participations.table_headers.competition", currentLocale)}
                </th>
                <th class="text-left px-3 py-2 text-sm font-semibold text-sky-700 dark:text-sky-300">
                  {t("participations.table_headers.year", currentLocale)}
                </th>
                <th class="text-left px-3 py-2 text-sm font-semibold text-sky-700 dark:text-sky-300">
                  {t("participations.table_headers.rank", currentLocale)}
                </th>
              </tr>
            </thead>
            <tbody>
              {
                Object.entries(participations)
                  .flatMap(([, data]) => (data.entries || []).map((entry) => ({
                    ...entry,
                    name: data.name,
                    url: entry.url || data.url,
                  })))
                  .sort((a, b) => {
                    if (a.year !== b.year) return b.year - a.year;
                    return a.name.localeCompare(b.name);
                  })
                  .map((entry) => (
                    <tr class="transition hover:bg-teal-300/5">
                      <td class="px-3 py-2 text-sm font-medium">
                        {entry.url ? (
                          <a
                            href={entry.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sky-700 dark:text-sky-300 no-underline transition hover:text-teal-700 dark:hover:text-teal-300"
                          >
                            {entry.name}
                          </a>
                        ) : (
                          entry.name
                        )}
                      </td>
                      <td class="px-3 py-2 text-sm text-zinc-600 dark:text-zinc-400">
                        {entry.year}
                      </td>
                      <td class="px-3 py-2 text-sm font-semibold text-teal-700 dark:text-teal-300">
                        {entry.rank ? ordinalFunc(entry.rank) : "Participant"}
                      </td>
                    </tr>
                  ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4 md:flex-row">
      <div class="flex-1 rounded-xl border border-white/10 bg-white/5 p-4 shadow-sm backdrop-blur">
        <h4 class="m-0 mb-3 text-base font-semibold text-zinc-900 dark:text-white">Socials</h4>
        <div class="flex flex-col gap-2">
          <a
            class="inline-flex items-center gap-2 px-3 py-2 rounded-md bg-white/5 border border-white/10 no-underline text-inherit transition backdrop-blur hover:-translate-y-0.5 hover:bg-teal-300/10 hover:border-teal-300/30"
            href="https://github.com/Biri0/"
            target="_blank"
            rel="noopener noreferrer"
            title={t("socials.github", currentLocale)}
          >
            <span class="text-base">👨‍💻</span>
            {t("socials.github", currentLocale)}
          </a>
          <a
            class="inline-flex items-center gap-2 px-3 py-2 rounded-md bg-white/5 border border-white/10 no-underline text-inherit transition backdrop-blur hover:-translate-y-0.5 hover:bg-teal-300/10 hover:border-teal-300/30"
            href="https://www.goodreads.com/rfmariano"
            target="_blank"
            rel="noopener noreferrer"
            title={t("socials.goodreads", currentLocale)}
          >
            <span class="text-base">📚</span>
            {t("socials.goodreads", currentLocale)}
          </a>
        </div>
      </div>
    </div>
  </aside>
</main>
