---
import {
    getCurrentLocale,
    getAlternateLocale,
    getLocalizedUrl,
    t,
} from "../utils/i18n.ts";

const currentLocale = getCurrentLocale(Astro.url.pathname);
const alternateLocale = getAlternateLocale(currentLocale);
const currentPath = Astro.url.pathname
    .replace(/^\/(en|it)\//, "/")
    .replace(/^\/$/, "");
const alternatePath = currentPath === "/" ? "" : currentPath;
const alternateUrl = getLocalizedUrl(alternatePath, alternateLocale);

const currentLangLabel = currentLocale === "en" ? "EN" : "IT";
const alternateLangLabel = alternateLocale === "en" ? "EN" : "IT";
const switchText = t("nav.language", currentLocale);
---

<div class="language-switcher inline-flex items-center gap-1 text-sm font-medium">
  <span class="text-zinc-700 dark:text-zinc-200" aria-label={`Current language: ${currentLangLabel}`}>
    {currentLangLabel}
  </span>
  <span class="select-none text-zinc-400">/</span>
  <a
    href={alternateUrl}
    class="text-zinc-600 dark:text-zinc-400 no-underline outline-none transition hover:text-zinc-800 dark:hover:text-zinc-200 focus-visible:ring-2 focus-visible:ring-sky-500/60 rounded"
    hreflang={alternateLocale}
    aria-label={`Switch to ${alternateLangLabel}`}
    title={`${switchText} (${alternateLangLabel})`}
  >
    {alternateLangLabel}
  </a>
</div>
