---
import type { Locale } from "../utils/i18n.ts";

export interface Props {
  currentLocale: Locale;
  label: string;
}

const { currentLocale, label } = Astro.props;
---

<div class="language" aria-label={label}>
  <a href="/" lang="en" hreflang="en" aria-label="English" aria-current={currentLocale === "en" ? "page" : undefined}>EN</a>
  <a href="/it/" lang="it" hreflang="it" aria-label="Italiano" aria-current={currentLocale === "it" ? "page" : undefined}>IT</a>
</div>
